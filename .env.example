# GEMINI_API_KEY: Chave de API do Google Gemini (para chamadas server-side ou proxy)
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# VITE_GEMINI_API_KEY: Chave de API do Gemini para chamadas diretas pelo cliente frontend
VITE_GEMINI_API_KEY="SUA_CHAVE_GEMINI_AQUI"

# VITE_OPENAI_API_KEY: Chave de API da OpenAI (caso opte por GPT-4o-mini no cliente frontend)
VITE_OPENAI_API_KEY="SUA_CHAVE_OPENAI_AQUI"

# OPENAI_API_KEY: Chave de API da OpenAI para chamadas server-side
OPENAI_API_KEY="SUA_CHAVE_OPENAI_AQUI"

# VITE_CLOUDFLARE_TURNSTILE_SITE_KEY: Chave do site do Cloudflare Turnstile
# Em dev: 1x00000000000000000000AA (teste universal)
# Em prod: 0x4AAAAAAFHknypuoYSkLpBF (chave real)
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY="1x00000000000000000000AA"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"
