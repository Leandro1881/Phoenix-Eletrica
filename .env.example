# GEMINI_API_KEY: Chave do Google Gemini, usada SOMENTE no servidor.
# Nunca crie chaves de IA com prefixo VITE_: elas vão para o JavaScript público do site.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# OPENAI_API_KEY: Chave de API da OpenAI para chamadas server-side
OPENAI_API_KEY="SUA_CHAVE_OPENAI_AQUI"

# VITE_CLOUDFLARE_TURNSTILE_SITE_KEY: Chave do site do Cloudflare Turnstile (a mesma em dev e prod)
# Para funcionar em dev, adicione "localhost" em Turnstile > widget > Hostname Management no painel Cloudflare.
# Se vazio, usa a chave real 0x4AAAAAAFHknypuoYSkLpBF.
# Chave de teste 1x00000000000000000000AA: só para dev offline; o token de teste é recusado em produção.
VITE_CLOUDFLARE_TURNSTILE_SITE_KEY="0x4AAAAAAFHknypuoYSkLpBF"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# GOOGLE_PLACES_API_KEY: Chave da Google Places API (New) para exibir as avaliações reais do Google no site
# Ative "Places API (New)" no Google Cloud Console e crie uma chave restrita a essa API.
GOOGLE_PLACES_API_KEY=""

# GOOGLE_PLACE_ID: (Opcional) Place ID da loja no Google. Se vazio, é descoberto automaticamente pelo endereço.
GOOGLE_PLACE_ID=""

# Limites do assistente de IA (opcional)
# CHAT_IP_MAX_REQUESTS=20
# CHAT_DAILY_MAX_REQUESTS=1000

# GCS_BUCKET: bucket do Google Cloud Storage para os anexos das cotações (link público permanente)
# Sem ele, os arquivos ficam no disco do servidor (em produção somem quando o servidor reinicia).
GCS_BUCKET=""

# GOOGLE_APPLICATION_CREDENTIALS: (só em dev) caminho do JSON da conta de serviço com acesso ao bucket.
# No Cloud Run não precisa: usa a conta de serviço do próprio serviço.
# GOOGLE_APPLICATION_CREDENTIALS="./gcp-key.json"

# PUBLIC_BASE_URL: (opcional) domínio público usado nos links quando GCS_BUCKET não está definido
# PUBLIC_BASE_URL="https://www.seudominio.com.br"

# ===== Painel do lojista =====
# ADMIN_PATH: endereço secreto do painel (12 a 64 letras minúsculas, números ou hífen). Sem ele, o painel não abre.
# /admin não existe. Em dev, sem ADMIN_PATH, o painel fica em /painel-local-dev.
# ADMIN_PATH="/gestao-troque-por-algo-aleatorio"

# ADMIN_SESSION_SECRET: segredo das sessões e da cifra do 2FA (mínimo 32 caracteres; gere com: openssl rand -hex 32).
# Obrigatório em produção: sem ele o login do painel fica desligado. Se mudar, o 2FA precisa ser cadastrado de novo.
# ADMIN_SESSION_SECRET=""

# ADMIN_USER / ADMIN_PASSWORD: criam o primeiro login quando o banco ainda não tem nenhum.
# Senha: mínimo 12 caracteres, com 3 destes: minúscula, maiúscula, número, símbolo. Não existe usuário padrão.
# ADMIN_USER=""
# ADMIN_PASSWORD=""

# ADMIN_RESET_2FA: (emergência) nome do usuário que perdeu o celular e os códigos de recuperação.
# Desliga o 2FA dele no próximo início; remova a variável depois do novo cadastro.
# ADMIN_RESET_2FA=""

# ADMIN_RESET_USER / ADMIN_RESET_PASSWORD: (emergência) login esquecido. Troca o usuário e a senha
# do painel no próximo início e desliga o 2FA. Remova as duas variáveis depois do primeiro acesso.
# ADMIN_RESET_USER=""
# ADMIN_RESET_PASSWORD=""

# UPLOAD_DAILY_MAX: teto de anexos enviados por dia no site todo (padrão 300)
# UPLOAD_DAILY_MAX=300
